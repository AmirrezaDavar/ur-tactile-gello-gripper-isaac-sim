        double3 xformOp:translate = (-0.2340264073127514, -0.630109878975849, 1.821916799633502)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "simpleTable" (
        prepend payload = @./simpleTable.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6858, 0.18291470182568043, 0.6205)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "tableSim"
        {
            rel physics:simulationOwner
        }
    }

    def "objectblue" (
        prepend payload = @./objectblue.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.7, 0.3463486699934327, 0.6205000281333923)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

