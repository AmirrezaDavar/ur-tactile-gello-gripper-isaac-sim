#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.4838444295775266, 0.24470819321842086, 1.064942281936129)
                double3 target = (-3.2206100867973833, -0.25730584139401336, -0.2544889472437457)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/World/ur10e/wrist_3_link/CameraJaw"
        }
        dictionary metricsAssembler = {
            dictionary "/World/tableSim" = {
            }
            int version = 1
        }
        dictionary omni_layer = {
            string authoring_layer = "./ur10e_gripper_scene.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @../1_fixed.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    def Camera "CameraTop"
    {
        float2 clippingRange = (0.01, 100)
        double focalLength = 35
        double horizontalAperture = 20.955
        custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -7.813165051458141)
        token projection = "perspective"
        double verticalAperture = 15.2908
        token visibility = "invisible"
        float3 xformOp:rotateXYZ = (68.5353, -1.9083329e-14, 90)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (6.492944625360126, 0.05239305258239815, 3.2217484546414035)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    over "ur10e"
    {
        string isaac:namespace (
            displayName = "Namespace"
            doc = "Namespace of the prim in Isaac Sim"
        )

        over "ee_link"
        {
        }

        over "base_link"
        {
            rel physics:simulationOwner
        }

        over "shoulder_link"
        {
            rel physics:simulationOwner
        }

        over "upper_arm_link"
        {
            rel physics:simulationOwner
        }

        over "forearm_link"
        {
            rel physics:simulationOwner
        }

        over "wrist_1_link"
        {
            rel physics:simulationOwner
        }

        over "wrist_2_link"
        {
            rel physics:simulationOwner
        }

        over "wrist_3_link"
        {
            rel physics:simulationOwner

            def Camera "CameraJaw"
            {
                float2 clippingRange = (0.01, 10)
                double focalLength = 24
                double horizontalAperture = 20.955
                custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -0.5236936755599936)
                token projection = "perspective"
                double verticalAperture = 15.2908
                token visibility = "invisible"
                float3 xformOp:rotateXYZ = (-121.16555, -0.01249339, 177.23022)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (-0.020103163416909244, -0.4324487224017798, -0.09242068425264283)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
            }
        }

        over "joints"
        {
            over "shoulder_pan_joint"
            {
                float drive:angular:physics:targetPosition = -0.5
                float physics:lowerLimit = -360
                float physics:upperLimit = 360
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "shoulder_lift_joint"
            {
                float drive:angular:physics:targetPosition = -72.200005
                float physics:lowerLimit = -360
                float physics:upperLimit = 360
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "elbow_joint"
            {
                float drive:angular:physics:targetPosition = 114.4
                float physics:lowerLimit = -180
                float physics:upperLimit = 180
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "wrist_1_joint"
            {
                float drive:angular:physics:targetPosition = -134.3
                float physics:lowerLimit = -360
                float physics:upperLimit = 360
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "wrist_2_joint"
            {
                float drive:angular:physics:targetPosition = -88.1
                float physics:lowerLimit = -360
                float physics:upperLimit = 360
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "wrist_3_joint"
            {
                float drive:angular:physics:targetPosition = -172.5
                float physics:lowerLimit = -360
                float physics:upperLimit = 360
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }
        }

        over "root_joint"
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    over "custom_gripper"
    {
        over "custom_gripper"
        {
            over "Base_Gripper"
            {
                rel physics:simulationOwner
                quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:scale:unitsResolve = (0.001, 0.001, 0.001)
                double3 xformOp:translate = (0, 0, 0)
                token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:scale:unitsResolve"]
            }

            over "left_finger_1"
            {
                rel physics:simulationOwner
                quatf xformOp:orient = (0.5, -0.5, -0.5, -0.5)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:scale:unitsResolve = (0.001, 0.001, 0.001)
                double3 xformOp:translate = (0.08776111395559091, 1.4857603504158615e-29, -0.1257908448222012)
                token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:scale:unitsResolve"]

                over "PrismaticJoint1"
                {
                    float drive:linear:physics:targetPosition = 0
                    float physics:lowerLimit = -0.0093
                    float physics:upperLimit = 0
                    float state:linear:physics:position = 0
                }

                over "left_finger_1"
                {
                    over "tn__finger_springstep_ZQ"
