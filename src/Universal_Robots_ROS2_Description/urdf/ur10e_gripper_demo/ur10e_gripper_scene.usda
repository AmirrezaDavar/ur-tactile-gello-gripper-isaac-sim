                rel physics:simulationOwner
                quatf xformOp:orient = (0.5, 0.5, -0.5, 0.5)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:scale:unitsResolve = (0.001, 0.001, 0.001)
                double3 xformOp:translate = (0.01970458658653285, -1.730126039545229e-30, -0.12578999999999976)
                token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:scale:unitsResolve"]

                over "PrismaticJoint2"
                {
                    float drive:linear:physics:targetPosition = 0
                    float physics:lowerLimit = -0.0093
                    float physics:upperLimit = 0
                    float state:linear:physics:position = 0
                }

