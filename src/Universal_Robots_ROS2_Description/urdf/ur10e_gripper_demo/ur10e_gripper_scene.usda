                    over "tn__finger_springstep_ZQ"
                    {
                        rel physics:simulationOwner
                    }

                    over "tn__smallpart_k9"
                    {
                        rel physics:simulationOwner
                    }
                }
            }

            over "right_finger_2"
            {
                rel physics:simulationOwner
                quatf xformOp:orient = (0.5, 0.5, -0.5, 0.5)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:scale:unitsResolve = (0.001, 0.001, 0.001)
                double3 xformOp:translate = (-0.08812975341906845, 2.532453046937384e-30, -0.12578999999999976)
                token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:scale:unitsResolve"]

                over "PrismaticJoint4"
                {
                    float drive:linear:physics:targetPosition = 0
                    float physics:lowerLimit = -0.0093
                    float physics:upperLimit = 0
                    float state:linear:physics:position = 0
                }

                over "right_finger_2"
                {
                    over "tn__finger_springstep_ZQ"
                    {
                        rel physics:simulationOwner
                    }

                    over "tn__smallpart_k9"
                    {
                        rel physics:simulationOwner
                    }
                }
            }
        }
    }

    over "GroundPlane"
    {
        over "CollisionPlane"
        {
            rel physics:simulationOwner
        }

        over "CollisionMesh"
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def Camera "cameraSide1"
    {
        float2 clippingRange = (0.01, 10)
        float focalLength = 24
        float focusDistance = 0
        custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -613585682270599.5)
        token visibility = "invisible"
        quatd xformOp:orient = (-0.3691065389298558, -0.24502962527900346, 0.41863234404722816, 0.7927596143676705)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.3077897303272366, 0.9869572530295115, 1.6881072919660187)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
